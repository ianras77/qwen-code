#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
QWEN_BIN="${ROOT}/bin/qwen"
RASSY_ENV="${QWENCODE_RASSY_ENV:-/data/apps/rassymind/.env}"

if [[ ! -x "$QWEN_BIN" ]]; then
  printf 'Qwen runtime wrapper is missing or not executable: %s\n' "$QWEN_BIN" >&2
  exit 127
fi

if [[ -f "$RASSY_ENV" ]]; then
  set -a
  # shellcheck disable=SC1090
  . "$RASSY_ENV"
  set +a
fi

BASE="${QWENCODE_OPENAI_BASE_URL:-${OPENAI_BASE_URL:-${RASSYMIND_BASE_URL:-http://127.0.0.1:8844}}}"
BASE="${BASE%/}"
if [[ "$BASE" != */v1 ]]; then
  BASE="$BASE/v1"
fi

API_KEY="${QWENCODE_OPENAI_API_KEY:-${OPENAI_API_KEY:-${RASSYMIND_API_KEY:-}}}"
if [[ -z "$API_KEY" ]]; then
  printf 'No API key available. Expected RASSYMIND_API_KEY via %s.\n' "$RASSY_ENV" >&2
  exit 2
fi

export OPENAI_API_KEY="$API_KEY"
export OPENAI_BASE_URL="$BASE"
export OPENAI_MODEL="${QWENCODE_OPENAI_MODEL:-rassy-fast}"
export QWEN_MODEL="${QWEN_MODEL:-$OPENAI_MODEL}"
export QWEN_HOME="${QWEN_HOME:-${ROOT}/state/qwen-home}"
export QWEN_RUNTIME_DIR="${QWEN_RUNTIME_DIR:-${ROOT}/state/qwen-runtime}"
export QWEN_CODE_API_TIMEOUT_MS="${QWENCODE_API_TIMEOUT_MS:-${QWEN_CODE_API_TIMEOUT_MS:-120000}}"
# RassyMind reserves bounded request capacity; do not let Qwen's 32K default
# over-reserve a lane for ordinary coding turns.
export QWEN_CODE_MAX_OUTPUT_TOKENS="${QWENCODE_MAX_OUTPUT_TOKENS:-${QWEN_CODE_MAX_OUTPUT_TOKENS:-8000}}"
export PATH="${ROOT}/bin:${ROOT}/runtime/qwen-code/node/bin:/usr/local/bin:/usr/bin:/bin:${PATH}"

mkdir -p "$QWEN_HOME" "$QWEN_RUNTIME_DIR"
exec "$QWEN_BIN" --auth-type openai "$@"
